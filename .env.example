# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_PAYER_EMAIL=
PAYPAL_SANDBOX_PLATFORM_EMAIL=
# Three business accounts, comma-separated: the Enugu, Lagos and Abuja pharmacies
PAYPAL_SANDBOX_MERCHANT_EMAILS=

# Claude API
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=

# Postgres (Neon)
DATABASE_URL=

# Public address of the app, used in links sent to Zapier. Not needed on Render, which sets RENDER_EXTERNAL_URL.
APP_URL=

# Zapier (optional): the URL of a "Webhooks by Zapier > Catch Hook" trigger. Order events are posted to it.
ZAPIER_HOOK_URL=

# Elasticsearch (optional): powers partner-pharmacy search. Fill the index with scripts/index-pharmacies.mjs.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
