# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_PAYER_EMAIL=
PAYPAL_SANDBOX_PLATFORM_EMAIL=
# Three business accounts, comma-separated: pharmacy, school, grocer
PAYPAL_SANDBOX_MERCHANT_EMAILS=

# Claude API
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=

# Postgres (Neon)
DATABASE_URL=
